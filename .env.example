# pasukkun 설정. 이 파일을 .env 로 복사해 값을 채운다. (.env 는 저장소에 올리지 않는다)

# - 필수 -
# 브라우저가 접속하는 프론트 주소 (끝에 / 없이). 요청 출처 검증과 알림 속 링크에 쓴다.
# 운영 예: https://pasukkun.example.com   로컬 개발 기본값: http://localhost:5273
APP_ORIGIN=http://localhost:5273

# (Docker 배포) 프록시가 서비스할 주소. 도메인을 넣으면 HTTPS 인증서를 자동 발급한다.
# APP_ORIGIN 과 같은 호스트여야 한다. 예: pasukkun.example.com
SITE_ADDRESS=localhost

# - 로그인 (GitHub OAuth) -
# 가입·로그인은 GitHub 계정으로만 한다. GitHub → Settings → Developer settings → OAuth Apps 에서 등록한다.
# Authorization callback URL: APP_ORIGIN + /api/v1/auth/github/callback
#   예) http://localhost:5273/api/v1/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
# 저장소에 올리지 말 것
GITHUB_OAUTH_CLIENT_SECRET=
# 로그인할 수 있는 GitHub 아이디 (쉼표 구분). 비우면 GitHub 계정이 있는 누구나 가입할 수 있다.
# 목록에서 빼면 그 사용자의 기존 세션과 알림도 바로 멈춘다.
# 아이디마다 처음 들어온 GitHub 계정만 허용하므로, 같은 아이디를 넘겨받은 다른 계정은 들어올 수 없다.
GITHUB_OAUTH_ALLOWED_USERS=
# 세션 유지 기간(일)
SESSION_TTL_DAYS=14
# 세션 쿠키의 Secure 속성. APP_ORIGIN 이 https 이거나 NODE_ENV=production 이면 기본 true.
# HTTPS 없이 시험할 때만 false 로 둔다.
# COOKIE_SECURE=false

# - GitHub 저장소 가져오기 (서비스 GitHub 앱, 운영자가 한 번 설정) -
# 이용자는 [GitHub 저장소 가져오기]로 저장소를 고르기만 한다. 이용자 토큰은 저장하지 않는다.
# GitHub → Settings → Developer settings → GitHub Apps → New GitHub App
#   Homepage URL: APP_ORIGIN
#   Callback URL: APP_ORIGIN + /api/v1/github/callback   (예: http://localhost:5273/api/v1/github/callback)
#   Request user authorization (OAuth) during installation: 끄기
#   Setup URL: APP_ORIGIN + /api/v1/github/setup, Redirect on update: 켜기
#   Webhook: Active 끄기
#   Repository permissions: Contents - Read-only (나머지는 No access)
#   Where can this GitHub App be installed?: Any account
# 만든 뒤: Client ID, Generate a new client secret, Generate a private key(.pem 파일 → secrets/ 에 두고 chmod 600)
# 앱 주소 https://github.com/apps/<slug> 의 <slug> 를 GITHUB_APP_SLUG 에 넣는다.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=secrets/github-app.pem
# 연결된 저장소의 lockfile 변경을 확인하는 주기(분, 최소 60)
GITHUB_SYNC_MINUTES=360

# - 알림 봇 (서비스 운영자가 한 번 설정) -
# 이용자는 토큰을 다루지 않는다. 알림 설정에서 [텔레그램 연결] / [디스코드 연결] 을 눌러 이 봇과 연결한다.
# 텔레그램: @BotFather 에서 /newbot 으로 만든 봇의 토큰
TELEGRAM_BOT_TOKEN=
# 디스코드: Developer Portal 의 Bot Token, Application(Client) ID, Client Secret
# Portal 설정: Bot → Public Bot 켜기, Requires OAuth2 Code Grant 켜기 / OAuth2 → Redirects 에
#   APP_ORIGIN + /api/v1/channels/discord/callback 추가
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# - 보안 브리핑 AI 요약 (선택) -
# 키를 넣으면 보안 브리핑을 보낼 때마다 Claude 를 1번 불러 헤드라인, 요약, 항목 문구를 한국어로 다듬는다.
# 이때 취약점 공개 정보와 영향받는 프로젝트 이름, 건수가 Anthropic API 로 전송된다.
# 비워 두면 정해진 틀로 만든다. 호출이 실패해도 정해진 틀로 보낸다.
ANTHROPIC_API_KEY=
# BRIEFING_AI_MODEL=claude-opus-5-5

# - 데이터 소스 (선택이지만 권장) -
# GitHub Advisory: 토큰이 없으면 시간당 60회, 있으면 5,000회. 권한이 필요 없는 토큰이면 된다.
# (로그인용 OAuth App 과는 별개다. Settings → Developer settings → Personal access tokens 에서 만든다.)
GITHUB_TOKEN=
# NVD: 키가 없으면 30초당 5회, 있으면 50회. https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# 최초 피드 적재 범위(일). 이 기간에 공개되거나 수정된 공지를 받는다.
# NVD 는 하루 수백 건이므로 90일이면 DB 가 수백 MB 가 된다. 가볍게 쓰려면 줄인다.
INITIAL_FEED_DAYS=90

# 수집 주기(분). NVD 는 2시간보다 자주 돌리지 않는다(공식 권고).
INGEST_GHSA_MINUTES=30
INGEST_NVD_MINUTES=120
INGEST_KEV_MINUTES=360
INGEST_EPSS_MINUTES=1440
# KISA 보호나라 보안공지 RSS 확인 주기(분, 최소 30)
INGEST_KISA_MINUTES=60
# 프로젝트 정기 재검사 주기(분)
RESCAN_MINUTES=1440

# - 판단·제한 -
# 대응 우선순위 규칙 R3 의 EPSS 임계값 (0-1)
EPSS_THRESHOLD=0.1
# lockfile 최대 크기(바이트)와 패키지 수
UPLOAD_MAX_BYTES=20971520
MAX_PACKAGES=50000
# 알림 전송 재시도 한도
NOTIFY_MAX_ATTEMPTS=6

# - 기타 -
# SQLite 파일 위치 (저장소 루트 기준 상대 경로 또는 절대 경로). Docker 에서는 /data/pasukkun.db 로 고정된다.
DATABASE_PATH=data/pasukkun.db
PORT=3000
# API 가 바인딩할 주소. 기본은 로컬 전용(127.0.0.1). Docker 에서는 0.0.0.0 으로 고정된다.
# HOST=127.0.0.1
# 앞단 프록시 단계 수. 기본 0 (X-Forwarded-For 를 믿지 않는다). Docker 구성에서는 1 로 고정된다.
# 프록시 없이 API 를 직접 노출한 상태에서 1 로 두면 요청 제한을 우회당할 수 있다.
# TRUST_PROXY=0
# API 문서(/api/v1/docs). 기본으로 꺼져 있고 켰을 때만 제공한다(인증 없이 열리므로 운영에서는 켜지 않는다).
# SWAGGER_ENABLED=false
