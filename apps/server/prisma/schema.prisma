// pasukkun 데이터 모델 (SQLite)
// - 배열 컬럼이 없으므로 목록은 Json 또는 조인 테이블로 표현한다.
// - 사용자별 조치 상태는 Finding 에만 두고 전역 Vulnerability 에는 저장하지 않는다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// - 계정 -

/// 계정은 GitHub OAuth 로만 만든다 (비밀번호를 저장하지 않는다).
model User {
  id          String   @id @default(cuid())
  /// GitHub 의 변하지 않는 사용자 ID. login 은 바뀔 수 있으므로 이 값으로 사람을 식별한다.
  githubId    String   @unique
  /// 화면 표시용 GitHub 아이디 (로그인할 때마다 갱신)
  githubLogin String
  name        String?
  createdAt   DateTime @default(now())
  lastLoginAt DateTime @default(now())

  sessions     Session[]
  settings     UserSettings?
  linkRequests ChannelLinkRequest[]
  githubLinks  GithubLinkRequest[]
  interests    UserTechnologyInterest[]
  projects     Project[]
  channels     NotificationChannel[]
  rules        SubscriptionRule[]
  deliveries   NotificationDelivery[]
  briefings    Briefing[]
}

model Session {
  /// sha256(세션 토큰). 원문 토큰은 쿠키에만 존재한다.
  id         String   @id
  userId     String
  csrfToken  String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum InterestMatchMode {
  /// 그룹 간 AND (기본)
  ALL_GROUPS
  /// 그룹 간 OR
  ANY_GROUP
}

model UserSettings {
  userId            String            @id
  timezone          String            @default("Asia/Seoul")
  interestMatchMode InterestMatchMode @default(ALL_GROUPS)
  quietHoursEnabled Boolean           @default(false)
  /// 자정 기준 분 단위 (사용자 시간대)
  quietStartMinute  Int               @default(1320)
  quietEndMinute    Int               @default(480)
  urgentBypassQuiet Boolean           @default(false)
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// - 기술 카탈로그 -

enum TechGroup {
  LANGUAGE
  FRAMEWORK
  RUNTIME
  INFRA
  DATABASE
}

enum ScanSupport {
  /// 설치 버전 정밀 검사 지원 (MVP: npm)
  PRECISE
  /// 피드 관련성 표시만 지원
  FEED_ONLY
}

model Technology {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  group       TechGroup
  aliases     Json
  scanSupport ScanSupport @default(FEED_ONLY)
  sortOrder   Int         @default(0)

  mappings        TechnologyMapping[]
  interests       UserTechnologyInterest[]
  vulnerabilities VulnerabilityTechnology[]
  projects        ProjectTechnology[]

  @@index([group])
}

enum MappingKind {
  /// 패키지 생태계 전체 (예: JavaScript → npm)
  ECOSYSTEM
  /// 특정 패키지 (예: React → npm:react)
  PACKAGE
  /// CPE vendor:product (예: Node.js → nodejs:node.js)
  CPE
}

model TechnologyMapping {
  id           String      @id @default(cuid())
  technologyId String
  kind         MappingKind
  /// ECOSYSTEM/PACKAGE 일 때의 생태계 (정규화된 소문자)
  ecosystem    String?
  /// PACKAGE: 패키지명, CPE: "vendor:product"
  pattern      String?
  technology   Technology  @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@unique([technologyId, kind, ecosystem, pattern])
  @@index([kind, ecosystem, pattern])
}

model UserTechnologyInterest {
  userId       String
  technologyId String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([userId, technologyId])
}

// - 취약점 -

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  /// 심각도 미제공 - 낮은 위험으로 취급하지 않는다
  UNKNOWN
}

enum PatchStatus {
  AVAILABLE
  /// 수정 버전 미확인
  UNCONFIRMED
}

model Vulnerability {
  id             String      @id @default(cuid())
  title          String
  publishedAt    DateTime?
  /// 출처가 보고한 최근 수정 시각 중 최댓값
  modifiedAt     DateTime?
  withdrawnAt    DateTime?
  severity       Severity    @default(UNKNOWN)
  severityRank   Int         @default(0)
  cvssScore      Float?
  cvssVersion    String?
  cvssVector     String?
  cvssSource     String?
  kevAddedAt     DateTime?
  kevDueDate     DateTime?
  kevRansomware  String?
  epssScore      Float?
  epssPercentile Float?
  epssDate       String?
  patchStatus    PatchStatus @default(UNCONFIRMED)
  /// 기술 카탈로그에 매핑되었는지 여부 (false = 미분류)
  classified     Boolean     @default(false)
  /// 검색용 비정규화 텍스트 (식별자, 패키지명, 제목)
  searchText     String      @default("")
  /// 영향 범위·수정 버전·철회 등 의미 있는 내용의 해시
  meaningfulHash String      @default("")
  rangeHash      String      @default("")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  identifiers  VulnerabilityIdentifier[]
  sources      SourceRecord[]
  cvss         VulnerabilityCvss[]
  affected     AffectedPackage[]
  products     VulnerabilityProduct[]
  technologies VulnerabilityTechnology[]
  findings     Finding[]
  events       NotificationEvent[]

  @@index([publishedAt])
  @@index([modifiedAt])
  @@index([severityRank])
  @@index([kevAddedAt])
  @@index([classified])
}

enum IdentifierType {
  CVE
  GHSA
  OSV
}

model VulnerabilityIdentifier {
  id              String         @id @default(cuid())
  vulnerabilityId String
  type            IdentifierType
  /// 대문자 정규화된 식별자. 전역 고유.
  value           String         @unique
  vulnerability   Vulnerability  @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)

  @@index([vulnerabilityId])
}

enum SourceKey {
  GHSA
  OSV
  NVD
  KEV
  EPSS
  KISA
}

/// 국내 공공 보안공지 (KISA 보호나라). 영향 버전 정보가 없으므로 버전 매칭에 쓰지 않고 목록·달력에만 보여준다.
model PublicNotice {
  id          String    @id @default(cuid())
  source      SourceKey
  /// 출처의 게시물 번호
  externalId  String
  title       String
  url         String
  publishedAt DateTime
  firstSeenAt DateTime  @default(now())

  @@unique([source, externalId])
  @@index([publishedAt])
}

model SourceRecord {
  id               String            @id @default(cuid())
  source           SourceKey
  sourceId         String
  vulnerabilityId  String
  /// 출처 원본(JSON) 을 gzip 으로 압축해 보존한다
  raw              Bytes
  rawHash          String
  sourceModifiedAt DateTime?
  withdrawn        Boolean           @default(false)
  /// 정규화 결과 (출처별로 보존해 충돌을 보여줄 수 있게 한다)
  title            String            @default("")
  /// 외부 공지 원문(Markdown). 렌더링 시 원시 HTML 은 비활성화한다.
  details          String            @default("")
  /// 참고 링크 [{ url, type }] - http/https 만 저장한다
  references       Json
  publishedAt      DateTime?
  severityLabel    Severity          @default(UNKNOWN)
  htmlUrl          String?
  fetchedAt        DateTime          @default(now())
  vulnerability    Vulnerability     @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  affected         AffectedPackage[]

  @@unique([source, sourceId])
  @@index([vulnerabilityId])
}

model VulnerabilityCvss {
  id              String        @id @default(cuid())
  vulnerabilityId String
  /// 점수 제공 출처 (예: GHSA, NVD:nvd@nist.gov)
  source          String
  version         String
  vector          String
  score           Float?
  vulnerability   Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)

  @@unique([vulnerabilityId, source, version])
}

model Package {
  id        String @id @default(cuid())
  /// 정규화된 생태계 (예: npm, pypi, maven)
  ecosystem String
  name      String

  affected  AffectedPackage[]
  installed SnapshotPackage[]
  findings  Finding[]

  @@unique([ecosystem, name])
}

model AffectedPackage {
  id              String        @id @default(cuid())
  vulnerabilityId String
  packageId       String
  sourceRecordId  String
  /// [{ introduced, introducedExclusive?, fixed?, lastAffected?, patched? }]
  intervals       Json
  /// 명시적으로 나열된 영향 버전
  versions        Json
  /// 해석하지 못한 범위 표현 (있으면 판단 불가 사유가 된다)
  unparsed        Json
  /// 출처가 명시한 취약 함수·심볼 (악용 조건 확인 항목으로 쓴다)
  functions       Json
  rangeHash       String
  vulnerability   Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  package         Package       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  sourceRecord    SourceRecord  @relation(fields: [sourceRecordId], references: [id], onDelete: Cascade)

  @@unique([sourceRecordId, packageId])
  @@index([packageId])
  @@index([vulnerabilityId])
}

/// NVD CPE 에서 추출한 vendor:product (기술 태깅 근거)
model VulnerabilityProduct {
  vulnerabilityId String
  vendor          String
  product         String
  vulnerability   Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)

  @@id([vulnerabilityId, vendor, product])
  @@index([vendor, product])
}

model VulnerabilityTechnology {
  vulnerabilityId String
  technologyId    String
  basis           MappingKind
  vulnerability   Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  technology      Technology    @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([vulnerabilityId, technologyId])
  @@index([technologyId])
}

model VulnerabilityMerge {
  id         String   @id @default(cuid())
  survivorId String
  mergedId   String
  reason     String
  createdAt  DateTime @default(now())
}

model KevEntry {
  cve            String    @id
  vendorProject  String    @default("")
  product        String    @default("")
  name           String    @default("")
  dateAdded      DateTime
  dueDate        DateTime?
  ransomwareUse  String    @default("Unknown")
  requiredAction String    @default("")
  firstSeenAt    DateTime  @default(now())
}

// - 프로젝트 -

enum Exposure {
  PUBLIC
  INTERNAL
  UNKNOWN
}

model Project {
  id             String   @id @default(cuid())
  userId         String
  name           String
  description    String   @default("")
  /// ["PRODUCTION","DEVELOPMENT","TEST"] 중 복수 선택
  environments   Json
  exposure       Exposure @default(UNKNOWN)
  runtime        String   @default("")
  runtimeVersion String   @default("")
  os             String   @default("")
  distro         String   @default("")
  arch           String   @default("")
  notes          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  technologies ProjectTechnology[]
  snapshots    ProjectSnapshot[]
  scans        ScanRun[]
  findings     Finding[]
  events       NotificationEvent[]
  repoSource   ProjectRepoSource?

  @@index([userId])
}

/// GitHub 저장소에서 lockfile 을 가져오는 프로젝트의 연결 정보.
/// 토큰은 저장하지 않는다. 가져올 때마다 서비스 GitHub 앱으로 1시간짜리 설치 토큰을 새로 만든다.
model ProjectRepoSource {
  projectId      String    @id
  /// GitHub 앱 설치 번호와 저장소 번호 (비밀값 아님)
  installationId String
  repoId         String
  /// owner/name. 이름이 바뀌면 확인할 때 갱신한다.
  fullName       String
  defaultBranch  String
  /// 저장소 안의 lockfile 경로 (예: pnpm-lock.yaml, apps/web/package-lock.json)
  lockfilePath   String
  /// 마지막으로 가져온 lockfile 의 blob sha. 같으면 다시 가져오지 않는다.
  lockfileSha    String?
  commitSha      String?
  /// OK / ERROR / DISCONNECTED
  status         String    @default("OK")
  error          String?
  /// 처음 가져올 때 사용 기술을 직접 의존성으로 채울지
  autoTech       Boolean   @default(true)
  lastCheckedAt  DateTime?
  lastChangedAt  DateTime?
  createdAt      DateTime  @default(now())
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([lastCheckedAt])
  @@index([repoId])
}

model ProjectTechnology {
  projectId    String
  technologyId String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
}

enum SnapshotInputType {
  LOCKFILE
  MANUAL
}

model ProjectSnapshot {
  id              String            @id @default(cuid())
  projectId       String
  seq             Int
  inputType       SnapshotInputType
  /// UPLOAD(화면에서 올림) / GITHUB(저장소에서 가져옴)
  source          String            @default("UPLOAD")
  /// NPM / PNPM / YARN
  lockfileFormat  String?
  /// GitHub 에서 가져온 경우 그 시점의 커밋
  sourceRef       String?
  fileName        String?
  fileSha256      String?
  lockfileVersion Int?
  /// 파싱 경고·미지원 항목 요약
  warnings        Json
  /// 스냅샷 시점의 프로젝트 구성 사본 (런타임, OS, 노출 등)
  projectConfig   Json
  packageCount    Int               @default(0)
  scannableCount  Int               @default(0)
  isCurrent       Boolean           @default(false)
  createdAt       DateTime          @default(now())
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  packages SnapshotPackage[]
  scans    ScanRun[]

  @@unique([projectId, seq])
  @@index([projectId, isCurrent])
}

enum RefKind {
  REGISTRY
  ALIAS
  GIT
  FILE
  LINK
  REMOTE_TARBALL
  UNKNOWN
}

model SnapshotPackage {
  id                String          @id @default(cuid())
  snapshotId        String
  packageId         String?
  name              String
  version           String
  /// lockfile 의 packages 키 (설치 위치)
  installPath       String
  isDirect          Boolean         @default(false)
  isDev             Boolean         @default(false)
  isOptional        Boolean         @default(false)
  /// 루트에서 이 패키지까지의 대표 의존성 경로 ["a@1.0.0", ...]
  dependencyPath    Json
  refKind           RefKind         @default(REGISTRY)
  scannable         Boolean         @default(true)
  unsupportedReason String?
  snapshot          ProjectSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  package           Package?        @relation(fields: [packageId], references: [id])

  @@index([snapshotId])
  @@index([packageId, version])
}

enum ScanTrigger {
  MANUAL
  SNAPSHOT_CREATED
  SCHEDULED
}

enum ScanStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  /// 일부 조회 실패 - 결과를 "일치 없음"으로 해석하면 안 된다
  PARTIAL
  FAILED
}

model ScanRun {
  id              String          @id @default(cuid())
  projectId       String
  snapshotId      String
  trigger         ScanTrigger
  status          ScanStatus      @default(QUEUED)
  /// 이 프로젝트의 첫 성공 검사인지 (알림을 요약 1건으로 묶는 기준)
  isInitial       Boolean         @default(false)
  packagesTotal   Int             @default(0)
  packagesScanned Int             @default(0)
  /// 검사 범위와 제외 항목 요약
  scope           Json
  /// 검사 시점의 소스별 수집 상태
  sourceFreshness Json
  summary         Json
  error           String?
  createdAt       DateTime        @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshot        ProjectSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

// - 프로젝트별 분석 결과 -

enum VersionMatch {
  AFFECTED
  NOT_AFFECTED
  UNKNOWN
}

enum ExploitCondition {
  MET
  NOT_MET
  NEEDS_CHECK
  NOT_ANALYZED
}

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
  /// 버전 매칭 판단 불가 - 확인 필요
  NEEDS_CHECK
}

enum RemediationStatus {
  UNREVIEWED
  IN_REVIEW
  PLANNED
  RISK_ACCEPTED
  DONE
}

model Finding {
  id                String            @id @default(cuid())
  projectId         String
  vulnerabilityId   String
  packageId         String
  version           String
  versionMatch      VersionMatch
  exploitCondition  ExploitCondition  @default(NOT_ANALYZED)
  priority          Priority
  priorityRank      Int               @default(0)
  /// 적용된 규칙 ID, 입력값, 설명
  priorityReasons   Json
  ruleVersion       String            @default("")
  /// 매칭 근거: 출처별 평가 결과, 일치 구간, 수정 버전, 설치 경로
  evidence          Json
  fixedVersion      String?
  remediationStatus RemediationStatus @default(UNREVIEWED)
  acceptReason      String?
  reviewDueAt       DateTime?
  /// 조치 예정일 (조치 예정 상태에서 정한 날짜, 비상 달력에 표시)
  plannedFixAt      DateTime?
  needsRecheck      Boolean           @default(false)
  recheckReason     String?
  /// 현재 구성에서 더 이상 검출되지 않게 된 시각 (재검사로만 설정)
  resolvedAt        DateTime?
  resolution        String?
  firstSeenScanId   String?
  lastSeenScanId    String?
  /// 평가에 사용된 영향 범위 해시
  rangeHash         String            @default("")
  analyzedAt        DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vulnerability     Vulnerability     @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  package           Package           @relation(fields: [packageId], references: [id])

  reviews FindingReview[]
  history FindingStatusHistory[]
  events  NotificationEvent[]

  @@unique([projectId, vulnerabilityId, packageId, version])
  @@index([projectId, resolvedAt, priorityRank])
  @@index([vulnerabilityId])
}

/// 수동 검토 기록 (추가 전용)
model FindingReview {
  id                String           @id @default(cuid())
  findingId         String
  authorId          String
  /// 작성 당시의 GitHub 아이디
  authorName        String
  verdict           ExploitCondition
  /// 확인한 조건 체크리스트 [{ label, state }]
  checks            Json
  rationale         String
  basedOnSnapshotId String?
  basedOnRangeHash  String           @default("")
  createdAt         DateTime         @default(now())
  finding           Finding          @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId, createdAt])
}

model FindingStatusHistory {
  id         String            @id @default(cuid())
  findingId  String
  fromStatus RemediationStatus
  toStatus   RemediationStatus
  authorId   String
  /// 작성 당시의 GitHub 아이디
  authorName String
  reason     String            @default("")
  createdAt  DateTime          @default(now())
  finding    Finding           @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId, createdAt])
}

// - 알림 -

enum ChannelType {
  TELEGRAM
  DISCORD
}

enum ChannelStatus {
  ACTIVE
  PAUSED
  /// 봇이 차단·추방되었거나 채널이 사라짐
  ERROR
}

/// 서비스 봇이 알림을 보낼 곳. 비밀값은 저장하지 않는다 (봇 키는 서버 설정에만 있다).
model NotificationChannel {
  id            String        @id @default(cuid())
  userId        String
  type          ChannelType
  name          String
  /// 보낼 곳. 텔레그램: { chatId, chatType, title } / 디스코드: { guildId, guildName, channelId, channelName }
  target        Json
  /// 화면 표시용 설명 (예: "디스코드 · 내서버 #alerts")
  label         String        @default("")
  status        ChannelStatus @default(ACTIVE)
  lastError     String?
  lastErrorAt   DateTime?
  lastSuccessAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  rules      RuleChannel[]
  deliveries NotificationDelivery[]

  @@index([userId])
}

enum RuleKind {
  /// 저장된 관심 기술 기준 알림
  TECH_INTEREST
  /// 프로젝트 영향 기준 알림
  PROJECT_IMPACT
}

model SubscriptionRule {
  id           String    @id @default(cuid())
  userId       String
  name         String
  kind         RuleKind
  /// 구독할 이벤트 종류 목록
  eventTypes   Json
  /// 이 심각도 이상만 (null = 제한 없음). 심각도 미제공은 항상 포함한다.
  minSeverity  Severity?
  /// PROJECT_IMPACT: 대상 프로젝트 ID 목록 (빈 배열 = 내 모든 프로젝트)
  projectIds   Json
  /// 받는 시간: { type: IMMEDIATE } | { type: DAILY, times } | { type: WEEKLY, days, time } | { type: INTERVAL, hours }
  schedule     Json
  /// 사용자가 정한 알림 문구 틀 (null 이면 기본 형식)
  template     String?
  /// 요약 형식: LIST (알림 제목 목록) | BRIEFING (보안 브리핑, 새 항목이 없어도 매번 보냄)
  digestFormat String    @default("LIST")
  /// 마지막으로 요약을 보낸 시각
  lastDigestAt DateTime?
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  channels   RuleChannel[]
  deliveries NotificationDelivery[]
  briefings  Briefing[]

  @@index([userId])
}

model RuleChannel {
  ruleId    String
  channelId String
  rule      SubscriptionRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  channel   NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([ruleId, channelId])
}

enum EventType {
  TECH_NEW_VULN
  PROJECT_NEW_MATCH
  KEV_ADDED
  PATCH_AVAILABLE
  AFFECTED_RANGE_CHANGED
  PRIORITY_RAISED
  INITIAL_SCAN_SUMMARY
}

/// Outbox: 도메인 변경과 같은 트랜잭션에서 기록되고 relay 가 발송 건으로 펼친다.
model NotificationEvent {
  id                String         @id @default(cuid())
  type              EventType
  vulnerabilityId   String?
  projectId         String?
  findingId         String?
  payload           Json
  /// 의미 있는 변경만 반영한 지문 (수정 시각 제외)
  changeFingerprint String
  createdAt         DateTime       @default(now())
  relayedAt         DateTime?
  vulnerability     Vulnerability? @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  project           Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  finding           Finding?       @relation(fields: [findingId], references: [id], onDelete: SetNull)

  deliveries NotificationDelivery[]

  @@index([relayedAt, createdAt])
}

enum DeliveryStatus {
  PENDING
  SENDING
  SENT
  RETRYING
  /// 재시도 한도 초과 또는 영구 오류
  FAILED
  /// 중복으로 판단되어 발송하지 않음
  SUPPRESSED
  /// 방해 금지 시간으로 보류
  HELD
  /// 일일 요약 대기
  DIGEST_PENDING
  /// 일일 요약에 포함되어 발송됨
  DIGESTED
  /// 채널 일시 중지·삭제 등으로 취소
  CANCELLED
}

model NotificationDelivery {
  id                String              @id @default(cuid())
  eventId           String?
  userId            String
  ruleId            String?
  channelId         String
  /// 프로젝트 영향 알림일 때의 대상 프로젝트 (관심 기술 알림은 null)
  projectId         String?
  /// TEST: 연결 테스트, EVENT: 이벤트 알림, DIGEST: 일일 요약
  kind              String              @default("EVENT")
  dedupeKey         String              @unique
  status            DeliveryStatus      @default(PENDING)
  attempts          Int                 @default(0)
  nextAttemptAt     DateTime            @default(now())
  lockedUntil       DateTime?
  lastError         String?
  lastStatusCode    Int?
  providerMessageId String?
  /// 발송에 사용한 메시지 요약 (비밀값 없음)
  title             String              @default("")
  digestId          String?
  /// 보안 브리핑: 이 브리핑을 보내는 건이거나, 이 브리핑에 모인 알림
  briefingId        Int?
  createdAt         DateTime            @default(now())
  sentAt            DateTime?
  event             NotificationEvent?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule              SubscriptionRule?   @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  channel           NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  briefing          Briefing?           @relation(fields: [briefingId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([briefingId])
  @@index([userId, createdAt])
}

/// 보낸 보안 브리핑. 보낸 내용을 그대로 남겨 화면에서 다시 볼 수 있게 한다.
model Briefing {
  id        Int               @id @default(autoincrement())
  userId    String
  ruleId    String?
  ruleName  String
  /// 예정 발송 시각
  slotAt    DateTime
  /// 이 시각 이후 들어온 항목을 모았다
  fromAt    DateTime
  /// BUILDING | READY
  status    String            @default("BUILDING")
  title     String            @default("")
  headline  String            @default("")
  summary   String            @default("")
  tone      String            @default("info")
  /// 새 이슈, 패치 확인, 국내 보안공지. 화면과 메시지가 같은 내용을 쓴다.
  content   Json?
  /// AI 요약에 쓴 모델 (정해진 틀로 만들었으면 null)
  aiModel   String?
  /// AI 요약을 못 했을 때의 이유 (비밀값 없음)
  aiError   String?
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule      SubscriptionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  deliveries NotificationDelivery[]

  @@unique([ruleId, slotAt])
  @@index([userId, id])
}

/// GitHub 저장소 가져오기 진행 상태. 사용자의 GitHub 토큰은 저장하지 않고, 그 토큰으로 확인한
/// "이 사용자가 접근할 수 있는 저장소 목록"(비밀값 아님)만 15분 동안 둔다.
model GithubLinkRequest {
  id        String   @id @default(cuid())
  userId    String
  /// sha256(OAuth state)
  stateHash String   @unique
  /// PENDING → READY → COMPLETED / FAILED / EXPIRED
  status    String   @default("PENDING")
  /// [{ installationId, repoId, fullName, private, description, defaultBranch }]
  repos     Json?
  error     String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// - 수집 -

enum IngestionStatus {
  NEVER_RUN
  OK
  FAILING
}

model IngestionSource {
  key                 SourceKey       @id
  enabled             Boolean         @default(true)
  intervalMinutes     Int
  status              IngestionStatus @default(NEVER_RUN)
  lastAttemptAt       DateTime?
  lastSuccessAt       DateTime?
  lastError           String?
  consecutiveFailures Int             @default(0)
  /// 초기 적재(backfill) 완료 여부 - 완료 전 수집분은 알림을 만들지 않는다
  backfillDone        Boolean         @default(false)

  checkpoints IngestionCheckpoint[]
  runs        IngestionRun[]
}

model IngestionCheckpoint {
  source    SourceKey
  stream    String
  /// 성공적으로 저장을 마친 범위까지의 커서
  cursor    Json
  updatedAt DateTime        @updatedAt
  src       IngestionSource @relation(fields: [source], references: [key], onDelete: Cascade)

  @@id([source, stream])
}

model IngestionRun {
  id         String          @id @default(cuid())
  source     SourceKey
  status     String          @default("RUNNING")
  windowFrom DateTime?
  windowTo   DateTime?
  fetched    Int             @default(0)
  upserted   Int             @default(0)
  changed    Int             @default(0)
  error      String?
  startedAt  DateTime        @default(now())
  finishedAt DateTime?
  src        IngestionSource @relation(fields: [source], references: [key], onDelete: Cascade)

  @@index([source, startedAt])
}

// - 작업 큐 -

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      JobStatus @default(QUEUED)
  /// 같은 키의 대기 중 작업은 하나만 둔다
  dedupeKey   String?
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lockedUntil DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([status, runAt])
  @@index([dedupeKey, status])
}

/// 텔레그램·디스코드 연결 진행 중 상태. 연결 코드는 해시로만 저장하고 짧게 만료된다.
model ChannelLinkRequest {
  id        String      @id @default(cuid())
  userId    String
  type      ChannelType
  name      String
  /// sha256(연결 코드 또는 OAuth state)
  codeHash  String      @unique
  /// PENDING → (디스코드: GUILD_SELECTED) → COMPLETED / EXPIRED / FAILED
  status    String      @default("PENDING")
  guildId   String?
  guildName String?
  channelId String?
  error     String?
  expiresAt DateTime
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// 작은 상태값 저장소 (예: 텔레그램 getUpdates offset)
model AppState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
